# ---- Supabase (cuentas + base de datos) ----
# Panel de Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Solo servidor. NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- Cifrado de tokens de pagina ----
# Genera una: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ---- Dominio publico de la app ----
# El cliente debe pegar ESTE dominio en su app de Facebook.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Cron para posts programados ----
CRON_SECRET=

# ---- Stripe (mas adelante, para cobrar) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_PRO=
